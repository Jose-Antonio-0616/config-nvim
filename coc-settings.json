{
  "coc.preferences.extensions": [
    "coc-html",
    "coc-css",
    "coc-tailwindcss",
    "coc-json",
    "coc-tsserver",
    "coc-emmet",
    "coc-ruff",
    "coc-pyright",
    "coc-sh",
    "coc-prettier",
    "coc-texlab",
    "coc-clangd"
  ],

  // --- Configuraciones de Sugerencias ---
  "suggest.noselect": false,
  "suggest.enablePreview": true,
  "suggest.enablePreselect": true,
  "suggest.autoTrigger": "always",
  "suggest.minTriggerInputLength": 1,
  "suggest.acceptSuggestionOnEnter": "on",
  "suggest.pumFloatConfig": {
    "border": true,
    "rounded": true
  },

  // --- Formateo al Guardar ---
  "coc.preferences.formatOnSaveFiletypes": [
    "html",
    "css",
    "markdown",
    "javascript",
    "typescript",
    "json",
    "htmldjango",
    "python"
  ],

  "coc.formatters": {
    "html": "prettier",
    "css": "prettier",
    "javascript": "prettier",
    "typescript": "prettier",
    "json": "prettier",
    "markdown": "prettier",
    "htmldjango": "djlint",
    "python": "ruff"
  },

  "coc.actions.onSave": {
    "source.fixAll.ruff": true,
    "source.organizeImports.ruff":true
  },

  // --- PYTHON (Configuración Moderna) ---
  "python.analysis.venvPath": ".",
  "python.pythonPath": "python3",

  // --- RUFF (Reemplaza a Black, Flake8, isort, Pylint) ---
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "ruff.format": true,

  // --- JavaScript / TypeScript (para Alpine.js) ---
  "tsserver.enable": true,
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,
  "eslint.enable": true,
  "eslint.filetypes": ["javascript", "typescript"],
  "eslint.options": {
    "extensions": [".js", ".ts"]
  },

  // --- HTML / Emmet (para HTMX) ---
  "html.enable": true,
  "html.suggest.html5": true,
  "html.filetypes": ["html", "htmldjango"],
  "emmet.includeLanguages": {
    "javascript": "javascript",
    "typescript": "typescript",
    "markdown": "markdown",
    "htmldjango": "html"
  },

  // --- CSS / Tailwind ---
  "css.enable": true,
  "css.validate": true,
  "tailwindCSS.experimental.classRegex": [
    "class[:]\s*['\"][^'\"]*['\"]|className[:]\s*['\"][^'\"]*['"]|tw[`]([^`]*)[`]`
  ],
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "htmldjango": "html"
  },

  // --- C/C++ (PlatformIO / Clangd) ---
  "clangd.enabled": true,
  "clangd.arguments": [
    "--background-index",
    "--query-driver=/home/jose/.platformio/packages/toolchain-*/bin/*gcc*,/home/jose/.platformio/packages/toolchain-*/bin/*g++*",
    "--header-insertion=iwyu",
    "--completion-style=detailed"
  ],
  "clangd.fallbackFlags": ["-std=c++17"]

  // --- JSON / SH ---
  "json.enable": true,
  "languageserver": {
    "bash": {
      "command": "bash-language-server",
      "args": ["start"],
      "filetypes": ["sh", "bash"],
      "ignoredRootPaths": ["~"]
    }
  },

  // --- Diagnósticos (Están bien) ---
  "diagnostic.errorSign": "✗",
  "diagnostic.warningSign": "⚠",
  "diagnostic.infoSign": "ℹ",
  "diagnostic.hintSign": "💡",
  "diagnostic.checkCurrentLine": true
}
